{
    "name": "mops/mops",
    "description": "MOPS — Modern Open Portfolio System: self-hosted portfolio CMS.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Mops\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mops\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8000 -t public dev/router.php",
        "migrate": "php bin/mops migrate",
        "install": "php bin/mops migrate",
        "test": "phpunit",
        "lint": "find app bin tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "css": "npm run build:css",
        "build": "npm run build",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "serve": "Run the dev server on http://127.0.0.1:8000",
        "migrate": "Run pending database migrations",
        "lint": "Syntax-check every PHP file",
        "test": "Run the PHPUnit test suite",
        "build": "Build Tailwind CSS and bundle JS assets"
    }
}
