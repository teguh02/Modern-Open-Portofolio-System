APP_NAME="MOPS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_KEY=

# SQLite (default). Swap the driver to mysql/pgsql and fill the rest for other servers.
DB_DRIVER=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mops
DB_USER=
DB_PASSWORD=

# Where uploaded media lives. Kept outside the web root on purpose.
UPLOAD_MAX_MB=8

SESSION_NAME=mops_session
SESSION_LIFETIME=7200
