{% extends 'admin/layout.twig' %}
{% import 'admin/partials/icon.twig' as icons %}

{% block content %}
  <div class="grid gap-5 lg:grid-cols-4">
    {# --------------------------------------------------------- uploader #}
    <div class="card lg:col-span-1">
      <div class="card-header"><h2 class="text-sm font-semibold text-ink">Upload</h2></div>
      <form action="/admin/media" method="post" enctype="multipart/form-data" class="card-body space-y-3">
        {{ csrf_field() }}
        <label class="label" for="files">Pilih file (bisa banyak)</label>
        <input type="file" id="files" name="files[]" multiple accept="image/*,application/pdf" class="field text-xs">
        <p class="hint">JPG, PNG, GIF, WebP, SVG, AVIF, PDF. Maksimal {{ max_upload_mb }} MB per file (atur lewat <code>UPLOAD_MAX_MB</code>).</p>
        <button type="submit" class="btn-primary w-full">{{ icons.svg('upload', 'h-4 w-4') }} Upload</button>
      </form>
      <div class="card-body border-t border-line">
        <p class="text-xs text-muted">{{ pagination.total }} file · total {{ (total_size / 1024 / 1024)|round(2) }} MB</p>
      </div>
    </div>

    {# ------------------------------------------------------------ grid #}
    <div class="card lg:col-span-3">
      <div class="card-header">
        <h2 class="text-sm font-semibold text-ink">Media Library</h2>
        <form action="/admin/media" method="get" class="flex items-center gap-2">
          <input type="search" name="q" value="{{ search }}" class="field w-44" placeholder="Search…" aria-label="Search media">
          <button type="submit" class="btn-secondary btn-sm">{{ icons.svg('search', 'h-4 w-4') }}</button>
        </form>
      </div>

      <div class="card-body">
        {% if items|length == 0 %}
          <p class="py-10 text-center text-sm text-muted">Belum ada media.</p>
        {% else %}
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-4">
            {% for item in items %}
              <div class="overflow-hidden rounded-lg border border-line" x-data="modal">
                <div class="grid h-32 place-items-center bg-surface2">
                  {% if item.is_image %}
                    <img src="{{ item.url }}" alt="{{ item.alt }}" class="h-32 w-full object-cover" loading="lazy">
                  {% else %}
                    <span class="text-xs text-muted">{{ item.extension|upper }}</span>
                  {% endif %}
                </div>
                <div class="space-y-2 p-3">
                  <p class="truncate text-xs font-medium text-ink" title="{{ item.original_name }}">{{ item.original_name }}</p>
                  <p class="text-[11px] text-muted">{{ item.human_size }}{{ item.width ? ' · ' ~ item.width ~ '×' ~ item.height : '' }}</p>
                  <div class="flex items-center gap-1">
                    <button type="button" class="btn-text btn-sm" @click="show()">Edit</button>
                    <button type="button" class="btn-text btn-sm text-red-600 hover:bg-red-50"
                            x-data="confirmButton('Hapus file ini?')" @click="ask($event)" form="del-media-{{ item.id }}" type="submit">
                      {{ icons.svg('trash', 'h-4 w-4') }}
                    </button>
                  </div>
                </div>

                <div x-show="open" x-cloak class="fixed inset-0 z-50 grid place-items-center bg-slate-900/50 p-4">
                  <div class="w-full max-w-lg rounded-lg bg-surface p-5 shadow-xl">
                    <div class="flex items-center justify-between">
                      <h3 class="text-sm font-semibold text-ink">Edit media</h3>
                      <button type="button" class="btn-text btn-sm" @click="hide()">{{ icons.svg('x', 'h-4 w-4') }}</button>
                    </div>
                    <form action="/admin/media/{{ item.id }}" method="post" class="mt-4 space-y-3">
                      {{ csrf_field() }}
                      <div>
                        <label class="label" for="alt-{{ item.id }}">Alt text</label>
                        <input class="field" id="alt-{{ item.id }}" name="alt" value="{{ item.alt }}">
                      </div>
                      <div>
                        <label class="label" for="title-{{ item.id }}">Title</label>
                        <input class="field" id="title-{{ item.id }}" name="title" value="{{ item.title }}">
                      </div>
                      <div>
                        <label class="label">Path</label>
                        <input class="field font-mono text-xs" value="{{ item.path }}" readonly onclick="this.select()">
                        <p class="hint">Salin path ini untuk galeri proyek atau menyisipkan gambar di blog.</p>
                      </div>
                      <button type="submit" class="btn-primary w-full">Simpan</button>
                    </form>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# delete forms (buttons reference them with form="") #}
      {% for item in items %}
        <form id="del-media-{{ item.id }}" action="/admin/media/{{ item.id }}/delete" method="post" class="hidden">
          {{ csrf_field() }}
        </form>
      {% endfor %}

      {% include 'admin/partials/pagination.twig' with { pagination: pagination, search: search } %}
    </div>
  </div>
{% endblock %}
