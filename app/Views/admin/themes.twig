{% extends 'admin/layout.twig' %}
{% import 'admin/partials/icon.twig' as icons %}

{% block content %}
  {% if load_errors|length > 0 %}
    <div class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      {% for error in load_errors %}<p>{{ error }}</p>{% endfor %}
    </div>
  {% endif %}

  <div class="mb-5 rounded-lg border border-line bg-surface px-5 py-4 text-sm text-muted">
    Dua tema bawaan (<span class="font-medium text-ink">vantablo</span> — developer, gelap dan
    <span class="font-medium text-ink">lumica</span> — designer, terang) ikut terpasang sejak awal.
    Tema hanya merender data: mengganti tema tidak pernah menghapus data.
  </div>

  {% if supports_zip %}
  <div class="card mb-5">
    <div class="card-header">
      <h2 class="text-sm font-semibold text-ink">Unggah Tema (ZIP)</h2>
    </div>
    <form action="/admin/themes/upload" method="post" enctype="multipart/form-data" class="card-body flex flex-wrap items-end gap-3">
      {{ csrf_field() }}
      <div class="flex-1">
        <label for="theme_zip" class="mb-1 block text-xs text-muted">File .zip</label>
        <input type="file" name="theme_zip" id="theme_zip" accept=".zip" required class="w-full text-sm">
      </div>
      <button type="submit" class="btn-primary">Unggah &amp; Pasang</button>
    </form>
    <p class="card-body border-t border-line text-xs text-muted">
      ZIP harus berisi satu folder dengan <code>theme.json</code>, atau berkas datar dengan
      field <code>slug</code> di <code>theme.json</code>. Slug yang sudah ada akan ditolak.
    </p>
  </div>
  {% endif %}

  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {% for item in themes %}
      <div class="card flex flex-col">
        <div class="h-40 overflow-hidden rounded-t-lg border-b border-line bg-surface2">
          {% if item.screenshot %}
            <img src="/uploads/{{ item.screenshot }}" alt="{{ item.name }} preview" class="h-40 w-full object-cover">
          {% else %}
            <div class="grid h-40 place-items-center text-muted">{{ icons.svg('swatch', 'h-8 w-8') }}</div>
          {% endif %}
        </div>
        <div class="card-body flex-1">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-sm font-semibold text-ink">{{ item.name }}</h2>
              <p class="text-xs text-muted">{{ item.slug }} · v{{ item.version }}</p>
            </div>
            {% if item.is_active %}
              <span class="pill bg-green-100 text-green-700">active</span>
            {% elseif not item.valid %}
              <span class="pill bg-red-100 text-red-700">incomplete</span>
            {% endif %}
          </div>
          <p class="mt-2 text-xs text-muted">{{ item.description }}</p>
          <p class="mt-2 text-xs text-muted">Oleh {{ item.author }} · persona {{ item.persona }}</p>

          {% if not item.valid %}
            <p class="mt-3 text-xs text-red-600">Template hilang: {{ item.missing_templates|join(', ') }}</p>
          {% endif %}
        </div>
        <div class="card-body border-t border-line flex items-center justify-between gap-2">
          {% if item.is_active %}
            <span class="text-xs text-muted">Tema aktif</span>
            <button type="button" class="btn-secondary" disabled>Aktif</button>
          {% else %}
            <form action="/admin/themes/{{ item.slug }}/delete" method="post">
              {{ csrf_field() }}
              <button type="submit" class="btn-text text-red-600 hover:bg-red-50"
                      x-data="confirmButton('Hapus tema {{ item.slug }}? Foldernya ikut terhapus.')" @click="ask($event)">
                {{ icons.svg('trash', 'h-4 w-4') }}
              </button>
            </form>
            <form action="/admin/themes/{{ item.slug }}/activate" method="post">
              {{ csrf_field() }}
              <button type="submit" class="btn-primary" {{ item.valid ? '' : 'disabled' }}>Aktifkan</button>
            </form>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="card card-body text-sm text-muted">Belum ada tema di folder <code>themes/</code>.</div>
    {% endfor %}
  </div>
{% endblock %}
