{% macro svg(name, class) %}
  {%- set cls = class|default('h-5 w-5') -%}
  <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- if name == 'grid' -%}
      <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
    {%- elseif name == 'user' -%}
      <circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>
    {%- elseif name == 'briefcase' -%}
      <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/>
    {%- elseif name == 'academic' -%}
      <path d="M3 9.5 12 5l9 4.5-9 4.5-9-4.5Z"/><path d="M6.5 11.8V16c0 1.4 2.5 2.6 5.5 2.6s5.5-1.2 5.5-2.6v-4.2"/>
    {%- elseif name == 'sparkles' -%}
      <path d="M12 3.5 13.6 8 18 9.6 13.6 11.2 12 15.7 10.4 11.2 6 9.6 10.4 8 12 3.5Z"/><path d="M18.5 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8Z"/>
    {%- elseif name == 'badge' -%}
      <path d="M12 3.5 14.2 6l3.3.4.4 3.3L20 12l-2.1 2.3-.4 3.3-3.3.4L12 20.5 9.8 18l-3.3-.4-.4-3.3L4 12l2.1-2.3.4-3.3L9.8 6 12 3.5Z"/><path d="m9.5 12 1.8 1.8 3.4-3.6"/>
    {%- elseif name == 'trophy' -%}
      <path d="M8 4h8v4a4 4 0 0 1-8 0V4Z"/><path d="M8 5.5H5.5v1A3.5 3.5 0 0 0 9 10"/><path d="M16 5.5h2.5v1A3.5 3.5 0 0 1 15 10"/><path d="M12 12v4"/><path d="M8.5 20h7"/><path d="M10 16h4l.5 4h-5l.5-4Z"/>
    {%- elseif name == 'cube' -%}
      <path d="M12 3.5 20 7.5v9L12 20.5 4 16.5v-9l8-4Z"/><path d="M4 7.5 12 11.5l8-4"/><path d="M12 11.5v9"/>
    {%- elseif name == 'document' -%}
      <path d="M14 3.5H7.5A1.5 1.5 0 0 0 6 5v14a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 18 19V7.5L14 3.5Z"/><path d="M14 3.5V8h4"/><path d="M9 12.5h6"/><path d="M9 16h4"/>
    {%- elseif name == 'photo' -%}
      <rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m4.5 17.5 4.5-4.2 3.5 3 3-2.6 4 3.8"/>
    {%- elseif name == 'swatch' -%}
      <path d="M4 15.5V5.5A1.5 1.5 0 0 1 5.5 4h3A1.5 1.5 0 0 1 10 5.5v10"/><path d="M14 8.5h4.5A1.5 1.5 0 0 1 20 10v8.5a1.5 1.5 0 0 1-1.5 1.5h-13"/><circle cx="8" cy="17" r="2.6"/>
    {%- elseif name == 'puzzle' -%}
      <path d="M10 4h4a1 1 0 0 1 1 1v1.5a2 2 0 1 0 4 0V6"/><path d="M4 10h1.5a2 2 0 1 0 0-4H6"/><rect x="4" y="10" width="16" height="10" rx="2"/>
    {%- elseif name == 'cog' -%}
      <circle cx="12" cy="12" r="3"/><path d="M12 3v2.2M12 18.8V21M4.2 7.5l1.9 1.1M17.9 15.4l1.9 1.1M4.2 16.5l1.9-1.1M17.9 8.6l1.9-1.1"/>
    {%- elseif name == 'archive' -%}
      <rect x="3" y="4" width="18" height="4.5" rx="1.2"/><path d="M5 8.5V19a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8.5"/><path d="M10 13h4"/>
    {%- elseif name == 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- elseif name == 'search' -%}
      <circle cx="11" cy="11" r="6"/><path d="m20 20-3.5-3.5"/>
    {%- elseif name == 'bell' -%}
      <path d="M18 15.5V11a6 6 0 0 0-12 0v4.5L4.5 18h15L18 15.5Z"/><path d="M10 18a2 2 0 0 0 4 0"/>
    {%- elseif name == 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- elseif name == 'x' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- elseif name == 'edit' -%}
      <path d="M4 20h4l10-10a2.5 2.5 0 0 0-3.5-3.5L4.5 16.5 4 20Z"/>
    {%- elseif name == 'trash' -%}
      <path d="M5 7h14"/><path d="M9 7V5h6v2"/><path d="M6.5 7l.8 12a1 1 0 0 0 1 1h7.4a1 1 0 0 0 1-1l.8-12"/><path d="M10.5 11v6M13.5 11v6"/>
    {%- elseif name == 'upload' -%}
      <path d="M12 16V5"/><path d="m8 9 4-4 4 4"/><path d="M4.5 16v2.5A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5V16"/>
    {%- elseif name == 'download' -%}
      <path d="M12 5v11"/><path d="m8 12 4 4 4-4"/><path d="M4.5 19h15"/>
    {%- elseif name == 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7"/>
    {%- elseif name == 'alert' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 8v5M12 16h.01"/>
    {%- elseif name == 'external' -%}
      <path d="M14 4h6v6"/><path d="m20 4-8.5 8.5"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
    {%- elseif name == 'copy' -%}
      <rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 5.5A1.5 1.5 0 0 0 13.5 4H6a2 2 0 0 0-2 2v7.5A1.5 1.5 0 0 0 5.5 15"/>
    {%- elseif name == 'logout' -%}
      <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/>
    {%- elseif name == 'eye' -%}
      <path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.8"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
    {%- endif -%}
  </svg>
{% endmacro %}
