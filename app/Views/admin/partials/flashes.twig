{% import 'admin/partials/icon.twig' as icons %}

{% if flash_messages is defined and flash_messages|length > 0 %}
  <div class="mb-5 space-y-2">
    {% for flash in flash_messages %}
      {% set tone = flash.type == 'error' ? 'border-red-200 bg-red-50 text-red-700' : (flash.type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-800' : 'border-green-200 bg-green-50 text-green-700') %}
      <div class="flex items-start gap-3 rounded-lg border px-4 py-3 text-sm {{ tone }}" role="status">
        <span class="mt-0.5 shrink-0">
          {{ flash.type == 'error' ? icons.svg('alert', 'h-4 w-4') : icons.svg('check', 'h-4 w-4') }}
        </span>
        <span>{{ flash.message }}</span>
      </div>
    {% endfor %}
  </div>
{% endif %}
