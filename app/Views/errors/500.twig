<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Error {{ status }} — MOPS</title>
  <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body class="min-h-screen bg-bg px-4 py-16 text-ink">
  <main class="mx-auto max-w-3xl">
    <p class="pill bg-red-100 text-red-700">Error {{ status }}</p>
    <h1 class="mt-4 text-2xl font-semibold text-ink">Ada yang salah di server</h1>
    <p class="mt-2 text-sm text-muted">{{ message }}</p>

    {% if trace %}
      <div class="mt-6 rounded-lg border border-line bg-surface p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-muted">{{ type }}</p>
        {% if file %}<p class="mt-1 font-mono text-xs text-muted">{{ file }}</p>{% endif %}
        <pre class="mt-3 max-h-80 overflow-auto whitespace-pre-wrap font-mono text-[11px] text-ink">{{ trace }}</pre>
      </div>
      <p class="mt-4 text-xs text-muted">
        Detail ini hanya tampil karena <code>APP_DEBUG=true</code>. Set <code>APP_DEBUG=false</code> di produksi.
      </p>
    {% endif %}

    <div class="mt-8 flex gap-3 text-sm">
      <a href="/" class="btn-primary">Beranda</a>
      <a href="/admin" class="btn-secondary">Admin</a>
    </div>
  </main>
</body>
</html>
