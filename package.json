{
    "name": "mops-assets",
    "private": true,
    "description": "Local Tailwind CSS build + bundled Alpine.js for MOPS. No CDN at runtime.",
    "scripts": {
        "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
        "build:js": "node scripts/bundle-js.mjs",
        "build": "npm run build:js && npm run build:css",
        "watch:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch"
    },
    "devDependencies": {
        "@alpinejs/csp": "^3.14.8",
        "@fontsource/fraunces": "^5.1.0",
        "@fontsource/inter": "^5.1.0",
        "@fontsource/jetbrains-mono": "^5.1.0",
        "tailwindcss": "^3.4.17"
    }
}
