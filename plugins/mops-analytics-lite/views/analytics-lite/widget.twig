<div class="card mt-5">
  <div class="card-header">
    <div>
      <h2 class="text-sm font-semibold text-ink">Analytics Lite</h2>
      <p class="text-xs text-muted">Halaman publik yang dilihat, dihitung plugin ini di tabelnya sendiri.</p>
    </div>
    <span class="pill bg-indigo-100 text-indigo-700">plugin</span>
  </div>
  <div class="card-body grid gap-5 md:grid-cols-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Total views</p>
      <p class="mt-1 text-3xl font-semibold text-ink">{{ total }}</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Last 7 days</p>
      <p class="mt-1 text-3xl font-semibold text-ink">{{ week }}</p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">Top halaman</p>
      {% if top|length == 0 %}
        <p class="mt-2 text-xs text-muted">Belum ada kunjungan.</p>
      {% else %}
        <ul class="mt-2 space-y-1 text-xs text-muted">
          {% for row in top %}
            <li class="flex items-center justify-between gap-3">
              <span class="truncate">{{ row.path }}</span>
              <span class="font-medium text-ink">{{ row.hits }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>
