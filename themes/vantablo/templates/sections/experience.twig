<section id="pengalaman" class="border-b border-line py-16 md:py-20">
  <div class="mx-auto max-w-content px-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-accent">02</p>
        {% if not section.hide_title|default(false) %}
          <h2 class="mt-1 font-mono text-2xl font-semibold text-ink">{{ section.title }}</h2>
        {% endif %}
        <p class="mt-1 font-mono text-xs text-muted">{{ section.total }} posisi</p>
      </div>
      {% if section.more_url %}
        <a href="{{ section.more_url }}" class="font-mono text-sm text-accent transition hover:opacity-80">
          Lihat selengkapnya →
        </a>
      {% endif %}
    </div>

    <ol class="mt-10 space-y-6">
      {% for item in section.items %}
        <li class="relative rounded-xl border border-line bg-surface p-5 md:p-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              {% if item.logo %}
                <img src="{{ upload_url(item.logo) }}" alt="{{ item.company }}" class="h-11 w-11 rounded-lg border border-line object-cover">
              {% endif %}
              <div>
                <h3 class="font-mono text-lg font-semibold text-ink">{{ item.title }}</h3>
                <p class="text-sm text-muted">
                  {% if item.company_url %}
                    <a href="{{ item.company_url }}" class="transition hover:text-accent" rel="noopener">{{ item.company }}</a>
                  {% else %}
                    {{ item.company }}
                  {% endif %}
                  {% if item.location %} · {{ item.location }}{% endif %}
                </p>
              </div>
            </div>
            <div class="text-right font-mono text-xs text-muted">
              <p>{{ item.period }}</p>
              {% if item.duration %}<p class="mt-1">{{ item.duration }}</p>{% endif %}
              {% if item.is_current %}
                <span class="mt-2 inline-flex items-center gap-1 rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-accent">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>aktif
                </span>
              {% endif %}
            </div>
          </div>

          {% if item.description %}
            <div class="t-prose mt-4 text-sm">{{ item.description|clean_html }}</div>
          {% endif %}

          {% if item.highlights|length > 0 %}
            <ul class="mt-4 space-y-1.5 text-sm text-muted">
              {% for highlight in item.highlights %}
                <li class="flex gap-2"><span class="text-accent">▸</span><span>{{ highlight }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}

          <p class="mt-4 font-mono text-[11px] uppercase tracking-widest text-muted">{{ item.employment_type }}</p>
        </li>
      {% else %}
        <li class="rounded-xl border border-dashed border-line p-6 text-center font-mono text-sm text-muted">
          Belum ada riwayat kerja.
        </li>
      {% endfor %}
    </ol>
  </div>
</section>
