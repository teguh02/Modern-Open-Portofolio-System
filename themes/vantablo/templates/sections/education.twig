<section id="pendidikan" class="border-b border-line py-16 md:py-20">
  <div class="mx-auto max-w-content px-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-accent">05</p>
        {% if not section.hide_title|default(false) %}
          <h2 class="mt-1 font-mono text-2xl font-semibold text-ink">{{ section.title }}</h2>
        {% endif %}
      </div>
      {% if section.more_url %}
        <a href="{{ section.more_url }}" class="font-mono text-sm text-accent transition hover:opacity-80">Lihat selengkapnya →</a>
      {% endif %}
    </div>

    <div class="mt-10 space-y-4">
      {% for item in section.items %}
        <div class="flex flex-wrap items-start justify-between gap-4 rounded-xl border border-line bg-surface p-5">
          <div class="flex items-start gap-4">
            {% if item.logo %}
              <img src="{{ upload_url(item.logo) }}" alt="{{ item.school }}" class="h-10 w-10 rounded-lg border border-line object-cover">
            {% endif %}
            <div>
              <h3 class="font-mono text-base font-semibold text-ink">{{ item.school }}</h3>
              <p class="text-sm text-muted">
                {{ item.degree }}{% if item.field_of_study %} · {{ item.field_of_study }}{% endif %}
              </p>
              {% if item.grade %}<p class="mt-1 font-mono text-xs text-muted">Nilai {{ item.grade }}</p>{% endif %}
              {% if item.description %}<p class="mt-2 text-sm text-muted">{{ item.description }}</p>{% endif %}
            </div>
          </div>
          <div class="text-right font-mono text-xs text-muted">
            <p>{{ item.period }}</p>
            {% if item.is_current %}<p class="mt-1 text-accent">berlangsung</p>{% endif %}
          </div>
        </div>
      {% else %}
        <p class="rounded-xl border border-dashed border-line p-6 text-center font-mono text-sm text-muted">Belum ada pendidikan.</p>
      {% endfor %}
    </div>
  </div>
</section>
