<section id="tulisan" class="border-b border-line py-16 md:py-20">
  <div class="mx-auto max-w-content px-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-accent">08</p>
        {% if not section.hide_title|default(false) %}
          <h2 class="mt-1 font-mono text-2xl font-semibold text-ink">{{ section.title }}</h2>
        {% endif %}
        <p class="mt-1 font-mono text-xs text-muted">{{ section.total }} tulisan</p>
      </div>
      {% if section.more_url %}
        <a href="{{ section.more_url }}" class="font-mono text-sm text-accent transition hover:opacity-80">Lihat selengkapnya →</a>
      {% endif %}
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {% for post in section.items %}
        <article class="rounded-xl border border-line bg-surface p-5 transition hover:border-brand/50">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
            {{ post.published_label }}{% if post.reading_time %} · {{ post.reading_time }} menit{% endif %}
          </p>
          <h3 class="mt-2 font-mono text-base font-semibold text-ink">
            <a href="/blog/{{ post.slug }}" class="transition hover:text-accent">{{ post.title }}</a>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{{ post.excerpt_text }}</p>
          {% if post.tags|length > 0 %}
            <div class="mt-3 flex flex-wrap gap-1.5">
              {% for tag in post.tags %}
                <span class="rounded border border-line bg-surface2 px-1.5 py-0.5 font-mono text-[11px] text-muted">#{{ tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% else %}
        <p class="rounded-xl border border-dashed border-line p-6 text-center font-mono text-sm text-muted sm:col-span-2">Belum ada tulisan.</p>
      {% endfor %}
    </div>
  </div>
</section>
