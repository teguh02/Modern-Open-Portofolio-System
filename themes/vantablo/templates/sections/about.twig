{% set view = section.items|first|default(profile) %}

{% if view.bio %}
  <section id="tentang" class="border-b border-line py-16 md:py-20">
    <div class="mx-auto grid max-w-content gap-8 px-5 md:grid-cols-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-accent">01</p>
        <h2 class="mt-1 font-mono text-2xl font-semibold text-ink">{{ section.title }}</h2>
      </div>
      <div class="md:col-span-2 t-prose">
        {{ view.bio|clean_html }}
      </div>
    </div>
  </section>
{% endif %}
