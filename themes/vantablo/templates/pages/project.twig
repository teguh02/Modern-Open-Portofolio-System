{% extends 'layout.twig' %}

{% block content %}
<article class="mx-auto max-w-content px-5 py-14">
  <a href="/projects" class="font-mono text-xs text-muted transition hover:text-accent">← Semua proyek</a>

  <header class="mt-6 border-b border-line pb-8">
    {% if project.featured %}
      <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 font-mono text-[11px] text-accent">unggulan</span>
    {% endif %}
    <h1 class="mt-3 font-mono text-3xl font-semibold text-ink md:text-4xl">{{ project.title }}</h1>
    {% if project.summary_text %}
      <p class="mt-3 max-w-2xl text-base text-muted">{{ project.summary_text }}</p>
    {% endif %}

    <dl class="mt-6 grid grid-cols-2 gap-4 font-mono text-xs text-muted sm:grid-cols-4">
      {% if project.role %}<div><dt class="uppercase tracking-widest">Peran</dt><dd class="mt-1 text-ink">{{ project.role }}</dd></div>{% endif %}
      {% if project.client %}<div><dt class="uppercase tracking-widest">Klien</dt><dd class="mt-1 text-ink">{{ project.client }}</dd></div>{% endif %}
      {% if project.period %}<div><dt class="uppercase tracking-widest">Periode</dt><dd class="mt-1 text-ink">{{ project.period }}</dd></div>{% endif %}
      {% if project.tech_stack|length > 0 %}
        <div><dt class="uppercase tracking-widest">Stack</dt><dd class="mt-1 text-ink">{{ project.tech_stack|join(', ') }}</dd></div>
      {% endif %}
    </dl>

    <div class="mt-6 flex flex-wrap gap-3 font-mono text-xs">
      {% if project.project_url %}<a href="{{ project.project_url }}" rel="noopener" class="rounded-lg bg-brand px-3 py-2 text-brandink">Kunjungi proyek</a>{% endif %}
      {% if project.repo_url %}<a href="{{ project.repo_url }}" rel="noopener" class="rounded-lg border border-line px-3 py-2 text-muted hover:text-ink">Repositori</a>{% endif %}
    </div>
  </header>

  {% if project.thumbnail %}
    <img src="{{ upload_url(project.thumbnail) }}" alt="{{ project.title }}" class="mt-8 w-full rounded-xl border border-line object-cover">
  {% endif %}

  {% if project.description %}
    <div class="t-prose mt-8 max-w-3xl">{{ project.description|clean_html }}</div>
  {% endif %}

  {% if project.gallery|length > 0 %}
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {% for image in project.gallery %}
        <img src="{{ upload_url(image) }}" alt="{{ project.title }}" class="w-full rounded-xl border border-line object-cover" loading="lazy">
      {% endfor %}
    </div>
  {% endif %}

  {% if related|default([])|length > 0 %}
    <section class="mt-14 border-t border-line pt-8">
      <h2 class="font-mono text-sm uppercase tracking-widest text-accent">Proyek lain</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in related|slice(0, 3) %}
          <a href="/projects/{{ item.slug }}" class="rounded-xl border border-line bg-surface p-4 transition hover:border-brand/50">
            <p class="font-mono text-sm font-semibold text-ink">{{ item.title }}</p>
            <p class="mt-1 text-xs text-muted">{{ item.summary_text }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>
{% endblock %}
