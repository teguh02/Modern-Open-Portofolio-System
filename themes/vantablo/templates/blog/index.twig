{% extends 'layout.twig' %}

{% block content %}
<div class="mx-auto max-w-content px-5 py-14">
  <a href="/" class="font-mono text-xs text-muted transition hover:text-accent">← Beranda</a>
  <header class="mt-4 border-b border-line pb-8">
    <h1 class="font-mono text-3xl font-semibold text-ink md:text-4xl">Tulisan</h1>
    <p class="mt-2 font-mono text-xs text-muted">{{ pagination.total }} tulisan · halaman {{ pagination.page }} dari {{ pagination.pages }}</p>
  </header>

  <div class="mt-10 space-y-4">
    {% for post in posts %}
      <article class="rounded-xl border border-line bg-surface p-5 transition hover:border-brand/50 md:p-6">
        <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
          {{ post.published_label }}{% if post.reading_time %} · {{ post.reading_time }} menit baca{% endif %}
        </p>
        <h2 class="mt-2 font-mono text-xl font-semibold text-ink">
          <a href="/blog/{{ post.slug }}" class="transition hover:text-accent">{{ post.title }}</a>
        </h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{{ post.excerpt_text }}</p>
        {% if post.tags|length > 0 %}
          <div class="mt-3 flex flex-wrap gap-1.5">
            {% for tag in post.tags %}
              <span class="rounded border border-line bg-surface2 px-1.5 py-0.5 font-mono text-[11px] text-muted">#{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </article>
    {% else %}
      <p class="rounded-xl border border-dashed border-line p-8 text-center font-mono text-sm text-muted">Belum ada tulisan yang dipublikasikan.</p>
    {% endfor %}
  </div>

  {% include 'partials/pagination.twig' ignore missing with {pagination: pagination} %}
</div>
{% endblock %}
