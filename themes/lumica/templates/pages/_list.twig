{# Shared shell for every section detail page: editorial page header + the
   matching section partial rendered with the full list (no "see more" button). #}
{% extends 'layout.twig' %}

{% block content %}
  <header class="border-b border-line">
    <div class="mx-auto max-w-content px-6 pb-14 pt-16">
      <a href="/" class="text-xs uppercase tracking-wider text-muted transition-colors hover:text-brand">← Beranda</a>
      <h1 class="mt-6 font-serif text-4xl tracking-tight text-ink md:text-5xl">{{ section.title }}</h1>
      <p class="mt-3 text-sm text-muted">{{ items|length }} item</p>
    </div>
  </header>

  {% include 'sections/' ~ section.id ~ '.twig' with {
    section: {id: section.id, title: section.title, items: items, total: items|length, more_url: null, hide_title: true}
  } only %}
{% endblock %}
