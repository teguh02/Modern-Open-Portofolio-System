{% set view = section.items|first|default(profile) %}

{% if view.bio %}
  <section id="tentang" class="border-b border-line py-16 md:py-24">
    <div class="mx-auto grid max-w-content gap-10 px-6 md:grid-cols-3">
      <h2 class="font-serif text-2xl tracking-tight text-ink md:text-3xl">{{ section.title }}</h2>
      <div class="t-prose max-w-2xl md:col-span-2">{{ view.bio|clean_html }}</div>
    </div>
  </section>
{% endif %}
