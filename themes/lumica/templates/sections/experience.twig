<section id="pengalaman" class="border-b border-line py-16 md:py-24">
  <div class="mx-auto max-w-content px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      {% if not section.hide_title|default(false) %}
        <h2 class="font-serif text-2xl tracking-tight text-ink md:text-3xl">{{ section.title }}</h2>
      {% endif %}
      {% if section.more_url %}
        <a href="{{ section.more_url }}" class="lumica-underline text-sm text-muted">Lihat selengkapnya</a>
      {% endif %}
    </div>

    <div class="mt-12 divide-y divide-line border-t border-line">
      {% for item in section.items %}
        <article class="grid gap-x-8 gap-y-3 py-8 md:grid-cols-12">
          <div class="md:col-span-3">
            <p class="text-sm text-muted">{{ item.period }}</p>
            {% if item.duration %}<p class="mt-1 text-xs text-muted">{{ item.duration }}</p>{% endif %}
            {% if item.is_current %}<p class="mt-2 text-xs uppercase tracking-wider text-accent">berlangsung</p>{% endif %}
          </div>
          <div class="md:col-span-9">
            <h3 class="font-serif text-xl leading-snug text-ink">{{ item.title }}</h3>
            <p class="mt-1 text-sm text-muted">
              {% if item.company_url %}<a href="{{ item.company_url }}" rel="noopener" class="transition-colors hover:text-brand">{{ item.company }}</a>{% else %}{{ item.company }}{% endif %}
              {% if item.location %} · {{ item.location }}{% endif %}
              {% if item.employment_type %} · {{ item.employment_type }}{% endif %}
            </p>
            {% if item.description %}<div class="t-prose mt-3 text-sm">{{ item.description|clean_html }}</div>{% endif %}
            {% if item.highlights|length > 0 %}
              <ul class="mt-3 space-y-1.5 text-sm text-muted">
                {% for highlight in item.highlights %}
                  <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span><span>{{ highlight }}</span></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </article>
      {% else %}
        <p class="py-8 text-sm text-muted">Belum ada riwayat kerja.</p>
      {% endfor %}
    </div>
  </div>
</section>
