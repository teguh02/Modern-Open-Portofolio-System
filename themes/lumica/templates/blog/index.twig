{% extends 'layout.twig' %}

{% block content %}
<div class="mx-auto max-w-content px-6 py-16">
  <header>
    <a href="/" class="text-xs uppercase tracking-wider text-muted transition-colors hover:text-brand">← Beranda</a>
    <h1 class="mt-6 font-serif text-4xl tracking-tight text-ink md:text-5xl">Tulisan</h1>
    <p class="mt-3 text-sm text-muted">{{ pagination.total }} tulisan · halaman {{ pagination.page }} dari {{ pagination.pages }}</p>
  </header>

  <div class="mt-12 divide-y divide-line border-t border-line">
    {% for post in posts %}
      <article class="grid gap-x-8 gap-y-2 py-8 md:grid-cols-12">
        <p class="text-xs uppercase tracking-wider text-muted md:col-span-3">
          {{ post.published_label }}{% if post.reading_time %} · {{ post.reading_time }} menit{% endif %}
        </p>
        <div class="md:col-span-9">
          <h2 class="font-serif text-2xl leading-snug text-ink">
            <a href="/blog/{{ post.slug }}" class="transition-colors hover:text-brand">{{ post.title }}</a>
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{{ post.excerpt_text }}</p>
          {% if post.tags|length > 0 %}
            <p class="mt-3 text-xs text-muted">{{ post.tags|map(t => '#' ~ t)|join('  ') }}</p>
          {% endif %}
        </div>
      </article>
    {% else %}
      <p class="py-10 text-sm text-muted">Belum ada tulisan yang dipublikasikan.</p>
    {% endfor %}
  </div>

  {% include 'partials/pagination.twig' ignore missing with {pagination: pagination} %}
</div>
{% endblock %}
