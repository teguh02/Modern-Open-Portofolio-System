{% extends 'layout.twig' %}

{% block content %}
<article class="mx-auto max-w-content px-6 py-16">
  <a href="/blog" class="text-xs uppercase tracking-wider text-muted transition-colors hover:text-brand">← Semua tulisan</a>

  <header class="mx-auto mt-8 max-w-2xl">
    <p class="text-xs uppercase tracking-wider text-muted">
      {{ post.published_label }}{% if post.reading_time %} · {{ post.reading_time }} menit baca{% endif %}
    </p>
    <h1 class="mt-4 font-serif text-4xl leading-tight tracking-tight text-ink md:text-[2.75rem]">{{ post.title }}</h1>
    {% if post.excerpt_text %}
      <p class="mt-5 text-lg leading-relaxed text-muted">{{ post.excerpt_text }}</p>
    {% endif %}
  </header>

  {% if post.cover_image %}
    <img src="{{ upload_url(post.cover_image) }}" alt="{{ post.title }}" class="mx-auto mt-10 w-full max-w-3xl rounded-2xl border border-line object-cover">
  {% endif %}

  <div class="t-prose mx-auto mt-12 max-w-2xl text-[1.0625rem]">
    {{ post.content|clean_html }}
  </div>

  {% if post.tags|length > 0 %}
    <div class="mx-auto mt-10 flex max-w-2xl flex-wrap gap-2 border-t border-line pt-6">
      {% for tag in post.tags %}
        <span class="rounded-full border border-line px-3 py-1 text-xs text-muted">{{ tag }}</span>
      {% endfor %}
    </div>
  {% endif %}

  {% if related|default([])|length > 0 %}
    <section class="mx-auto mt-16 max-w-2xl border-t border-line pt-8">
      <h2 class="font-serif text-xl text-ink">Tulisan terkait</h2>
      <ul class="mt-5 space-y-3">
        {% for item in related|slice(0, 3) %}
          <li>
            <a href="/blog/{{ item.slug }}" class="font-serif text-lg text-ink transition-colors hover:text-brand">{{ item.title }}</a>
            <span class="ml-2 text-xs text-muted">{{ item.published_label }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</article>
{% endblock %}
